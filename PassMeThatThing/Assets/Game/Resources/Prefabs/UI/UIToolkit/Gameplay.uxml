<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/Resources/Prefabs/UI/Gameplay/Gameplay.uss?fileID=7433441132597879392&amp;guid=e152551381caab343a416b55f7bf77d3&amp;type=3#Gameplay"/>
    <Style src="project://database/Assets/Game/Resources/Prefabs/UI/UIToolkit/USS/SpecialFont.uss?fileID=7433441132597879392&amp;guid=4632810691e1a36498776db3409c06bb&amp;type=3#SpecialFont"/>
    <ui:VisualElement name="Cursor" style="flex-grow: 0; width: 10px; height: 10px; align-self: center; flex-direction: column; align-content: center; justify-content: space-between; align-items: stretch; background-color: rgb(255, 255, 255); position: absolute; left: 50%; top: 50%; translate: -50% -50%;"/>
    <ui:VisualElement enabled="true" name="HealthVisualImg" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-image: resource(&quot;Sprites/low_hp&quot;); display: none; opacity: 0; visibility: hidden;"/>
    <ui:GroupBox class="tektur-font" style="align-self: auto; justify-content: center; align-items: auto; align-content: auto; height: 100%;">
        <ui:GroupBox name="WirePlacementContainer" style="align-self: center; top: 270px; visibility: hidden;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; width: 326px; align-self: center; height: 194px;">
                <ui:VisualElement name="LeftPlugSocketImage" class="wire-preview-socket" style="visibility: hidden;">
                    <ui:VisualElement name="LeftPlugImage" style="flex-grow: 1; background-image: resource(&quot;Sprites/BuildingSprites/pipe&quot;); -unity-background-scale-mode: scale-to-fit; background-position-x: center; visibility: hidden;"/>
                </ui:VisualElement>
                <ui:VisualElement name="RightPlugSocketImage" class="wire-preview-socket" style="visibility: hidden;">
                    <ui:VisualElement name="RightPlugImage" style="flex-grow: 1; background-image: resource(&quot;Sprites/wire_plug&quot;); background-position-y: center 0; -unity-background-scale-mode: scale-to-fit; background-position-x: right 0; visibility: hidden;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:GroupBox name="GroupBox" style="top: auto; font-size: 37px; -unity-text-align: middle-center; position: relative; bottom: 0; color: rgb(255, 255, 255); align-self: auto; align-items: flex-start; justify-content: flex-start; align-content: auto; width: 410px;">
                <ui:Label text="Choose another to connect" style="width: auto; align-self: center;"/>
                <ui:Label text="Choose again to clear" style="width: auto; align-self: center;"/>
                <ui:Label text="C to cancel" style="width: auto; align-self: center;"/>
            </ui:GroupBox>
        </ui:GroupBox>
        <ui:GroupBox name="EventsContainer" style="height: 593px; width: 294px; align-items: stretch; position: absolute; background-color: rgba(115, 115, 115, 0); justify-content: flex-start; top: 304px; left: auto; right: 0;"/>
        <Game.Scripts.GameFiles.LevelGeneration.UI.MinimapView name="Minimap" grid-cells-height="20" grid-line-color="rgba(149, 139, 139, 0.08)" cell-size="25" grid-cells-width="20" picking-mode="Position" tabindex="0" focusable="true" enabled="true" viewport-width="300" viewport-height="300" show-grid-lines="true" cell-color="rgb(45, 130, 60)" style="transform-origin: center; height: 300px; width: 300px; position: relative; top: 157px; left: auto; right: -138px; -unity-material: url(&quot;&quot;);">
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; right: auto; bottom: auto; left: 135px; top: 137px; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=-2236324273849735119&amp;guid=15e3c10aea467e4489bfdd34048a4004&amp;type=3#arrow-up&quot;); position: absolute; height: 26px; width: 31px;"/>
        </Game.Scripts.GameFiles.LevelGeneration.UI.MinimapView>
        <ui:VisualElement name="MinimapFrame" style="flex-grow: 1; top: -5px; right: -17px; position: absolute; height: 315px; width: 353px; background-image: resource(&quot;Sprites/GameplaySprites/minimap Frame&quot;); -unity-background-scale-mode: scale-to-fit;"/>
        <ui:GroupBox style="height: 107px; width: 516px; align-items: stretch; align-content: flex-start; align-self: flex-start; bottom: 0; position: absolute; left: auto; flex-direction: row; justify-content: space-between; font-size: 100%; right: 0;">
            <ui:Label text="Label" name="RemainingTimeLb" style="-unity-text-align: lower-left; color: rgb(255, 255, 255); font-size: 50px;"/>
            <ui:Label text="Label" name="PhaseLb" style="flex-grow: 1; font-size: 50%; color: rgb(255, 255, 255); -unity-text-align: lower-left;"/>
        </ui:GroupBox>
        <ui:GroupBox name="InventoryContainer" style="height: 278px; width: 584px; align-items: stretch; align-content: flex-start; align-self: center; position: absolute; left: 0%; bottom: 0; right: auto; translate: 0% 0; background-color: rgba(128, 128, 128, 0); justify-content: space-evenly; flex-direction: row; background-image: resource(&quot;Sprites/GameplaySprites/inventory_3s&quot;); -unity-background-scale-mode: scale-to-fit; background-position-y: bottom 0;">
            <ui:VisualElement name="Item1Img" class="inventory-item" style="position: absolute; top: 75px; left: 177px;"/>
            <ui:VisualElement name="Item2Img" class="inventory-item" style="flex-grow: 1; position: absolute; top: 78px; left: 324px;"/>
            <ui:VisualElement name="Item3Img" class="inventory-item" style="flex-grow: 1; position: absolute; left: 473px; top: 76px;"/>
        </ui:GroupBox>
        <ui:VisualElement name="PlayerHud" style="flex-grow: 1; position: absolute; height: 397px; top: 0; width: 395px; left: 0; -unity-background-scale-mode: scale-to-fit; background-position-y: top 0; background-position-x: left 0;">
            <ui:VisualElement style="flex-grow: 1; background-image: resource(&quot;Sprites/GameplaySprites/player_hud_clear&quot;);"/>
            <ui:ProgressBar title="" value="29.4" name="Health1" class="custom-progress-bar health-progress-bar" style="position: absolute; width: 186px; top: 35px; left: 185px; height: 19px;"/>
            <ui:ProgressBar title="" value="100" name="Stamina" class="custom-progress-bar stamina-progress-bar" style="position: absolute; width: 126px; top: 87px; left: 179px; height: 8px;"/>
            <ui:ProgressBar title="" value="29.4" name="Health2" class="custom-progress-bar health-progress-bar" style="position: absolute; width: 74px; top: 152px; left: 136px; height: 11px;"/>
            <ui:ProgressBar title="" value="29.4" name="Health3" class="custom-progress-bar health-progress-bar" style="position: absolute; width: 74px; top: 242px; left: 136px; height: 11px;"/>
            <ui:ProgressBar title="" value="29.4" name="Health4" class="custom-progress-bar health-progress-bar" style="position: absolute; width: 74px; top: 330px; left: 136px; height: 11px;"/>
            <ui:VisualElement name="Avatar1" class="avatar-image" style="flex-grow: 1; position: absolute; height: 86px; width: 87px; top: 25px; left: 72px;"/>
            <ui:VisualElement name="Avatar2" class="avatar-image" style="flex-grow: 1; position: absolute; height: 59px; width: 60px; top: 154px; left: 65px;"/>
            <ui:VisualElement name="Avatar3" class="avatar-image" style="flex-grow: 1; position: absolute; height: 59px; width: 57px; top: 242px; left: 66px;"/>
            <ui:VisualElement name="Avatar4" class="avatar-image" style="flex-grow: 1; position: absolute; height: 59px; width: 57px; top: 331px; left: 66px;"/>
            <ui:Label text="Label" name="name1" class="player-name" style="position: absolute; top: 4px; left: 174px;"/>
            <ui:Label text="Label" name="name2" class="player-name" style="position: absolute; top: 127px; left: 132px;"/>
            <ui:Label text="Label" name="name3" class="player-name" style="position: absolute; top: 218px; left: 132px;"/>
            <ui:Label text="Label" name="name4" class="player-name" style="position: absolute; top: 306px; left: 132px;"/>
        </ui:VisualElement>
        <ui:Label name="ThrowLb" style="flex-grow: 1; font-size: 100px; color: rgb(255, 255, 255); position: absolute; left: 959px; top: 540px; display: flex;"/>
    </ui:GroupBox>
    <ui:VisualElement style="flex-grow: 1; background-image: resource(&quot;Sprites/GameplaySprites/display&quot;); -unity-background-scale-mode: scale-to-fit; width: 1009px; align-self: center; background-position-y: top 0;">
        <ui:Label text="Pass out" style="font-size: 141px; -unity-text-align: middle-center; color: rgb(221, 92, 92); top: 467px;"/>
    </ui:VisualElement>
    <ui:VisualElement enabled="true" name="DeathVisualImg" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; display: flex; opacity: 0; justify-content: center; background-color: rgba(0, 0, 0, 0.84); top: 0; left: 0;"/>
</ui:UXML>
