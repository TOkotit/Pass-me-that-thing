<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-color: rgba(9, 9, 53, 0.37);">
        <ui:GroupBox name="MinigameContentContainer" style="height: 100%;" />
        <ui:Button name="CloseBtn" style="position: absolute; height: 139px; width: 137px; top: 0; left: auto; right: 0; bottom: auto; background-image: resource(&apos;Sprites/MinigameSprites/cancel&apos;); background-color: rgba(255, 255, 255, 0);" />
        <ui:VisualElement name="SuccessImg" style="flex-grow: 1; position: absolute; height: 308px; width: 300px; top: auto; left: 0; bottom: 0; right: auto; background-image: resource(&apos;Sprites/MinigameSprites/confirm_arrow&apos;);" />
    </ui:VisualElement>
</ui:UXML>
