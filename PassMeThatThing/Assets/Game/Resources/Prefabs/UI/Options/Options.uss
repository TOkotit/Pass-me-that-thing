.unity-tab {
    background-color: rgba(255, 255, 255, 0);
    width: 100%;
    height: 100%;
    flex-grow: 1;
    margin-top: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
}

.unity-tab-view {
    flex-direction: row;
    background-color: rgb(66, 65, 64);
}

.unity-tab__header {
    width: 419px;
    height: 122px;
    font-size: 60px;
    background-image: resource("Sprites/Menu/MenuBtn");
    background-color: rgba(255, 255, 255, 0);
    -unity-text-align: middle-center;
    justify-content: space-around;
    color: rgb(92, 221, 138);
    margin-bottom: 63px;
    transition-property: font-size, color;
    transition-duration: 0.2s, 0.2s;
}

.unity-tab__header-underline {
    display: none;
}

.unity-tab-view__header-container {
    flex-direction: column;
    flex-wrap: nowrap;
    align-self: center;
    background-color: rgba(255, 0, 0, 0);
    margin-left: 42px;
}

.unity-tab__content-container {
    width: 75%;
    height: 100%;
    flex-grow: 1;
    margin-bottom: 15px;
    margin-left: 15px;
    margin-top: 15px;
    border-top-width: 7px;
    border-right-width: 7px;
    border-bottom-width: 7px;
    border-left-width: 7px;
    border-left-color: rgb(89, 185, 123);
    border-right-color: rgb(89, 185, 123);
    border-top-color: rgb(89, 185, 123);
    border-bottom-color: rgb(89, 185, 123);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    color: rgb(92, 221, 138);
}

.unity-tab-view__content-container {
    width: 100%;
    height: 100%;
}

.unity-tab__header:hover {
    font-size: 83px;
    color: rgb(21, 146, 66);
}

.unity-tab__header:checked {
    width: 419px;
    height: 122px;
    background-image: resource("Sprites/Menu/MenuBtn");
    background-color: rgba(0, 255, 68, 0.157);
    justify-content: space-around;
    margin-bottom: 63px;
}

.custom-slider {
    flex-direction: column;
    margin-bottom: 30px;
    margin-top: 30px;
}

.custom-slider .unity-base-slider__tracker {
    height: 23px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(71, 190, 113);
    border-right-color: rgb(71, 190, 113);
    border-top-color: rgb(71, 190, 113);
    border-bottom-color: rgb(71, 190, 113);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.custom-slider .unity-base-slider__dragger {
    width: 68px;
    height: 66px;
    background-image: resource("Sprites/Menu/ValveIcon");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: -24px;
    transition-property: rotate;
    transition-duration: 0.2s;
}

.custom-slider .unity-base-slider__dragger:hover {
    width: 68px;
    height: 66px;
    background-image: resource("Sprites/Menu/ValveIcon");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: -24px;
    rotate: 20deg;
}

.custom-slider .unity-drager-border {
}

.custom-slider .unity-base-slider__drag-container {
    justify-content: center;
    align-items: auto;
    align-self: center;
    align-content: flex-start;
}

.custom-slider .unity-slider__label {
    font-size: 52px;
    -unity-text-align: middle-left;
    color: rgb(92, 221, 138);
}

.custom-slider .unity-slider__label:focus {
    color: rgb(92, 221, 138);
}

.custom-slider .unity-slider__input {
    font-size: 52px;
    -unity-text-align: middle-left;
    color: rgb(92, 221, 138);
    height: 70px;
}

.custom-dropdown {
    position: relative;
    width: 900px;
    margin: 4px;
}

.custom-dropdown__button {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(43, 43, 43, 0);
    border-color: rgb(30, 30, 30);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 10px;
    margin: 0;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(92, 221, 138);
    border-right-color: rgb(92, 221, 138);
    border-top-color: rgb(92, 221, 138);
    border-bottom-color: rgb(92, 221, 138);
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-right-radius: 26px;
    border-bottom-left-radius: 26px;
}

.custom-dropdown__button:hover {
    background-color: rgba(92, 221, 138, 0.396);
}

.custom-dropdown__label {
    font-size: 50px;
}

.custom-dropdown__arrow {
    transition: rotate 0.2s;
    background-image: resource("Sprites/Menu/ArrowIcon");
    width: 50px;
    height: 50px;
}

.custom-dropdown__arrow--open {
    rotate: 180deg;
}

.custom-dropdown__popup {
    background-color: rgb(37, 37, 37);
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 4px;
    z-index: 1000;
    width: 900px;
    height: 450px;
    position: absolute;
    border-left-color: rgb(92, 221, 138);
    border-right-color: rgb(92, 221, 138);
    border-top-color: rgb(92, 221, 138);
    border-bottom-color: rgb(92, 221, 138);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.custom-dropdown__item {
    background-color: transparent;
    border-width: 0;
    border-radius: 2px;
    text-align: left;
    padding: 6px 8px;
    margin: 1px 0;
    font-size: 30px;
    -unity-text-align: upper-left;
}

.custom-dropdown__item:hover {
    background-color: rgb(64, 64, 64);
}

.custom-dropdown__item--selected {
    background-color: rgb(44, 93, 136);
}

.custom-scroll-view {
}

.custom-scroll-view .unity-base-slider__dragger {
    background-color: rgb(45, 114, 70);
    border-left-color: rgb(92, 221, 138);
    border-right-color: rgb(92, 221, 138);
    border-top-color: rgb(92, 221, 138);
    border-bottom-color: rgb(92, 221, 138);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
    border-bottom-left-radius: 9px;
    position: relative;
    left: auto;
    top: auto;
    right: auto;
    bottom: auto;
    align-self: center;
    scale: 1 0.98;
}

.custom-scroll-view .unity-scroller__low-button {
    display: none;
    visibility: visible;
}

.custom-scroll-view .unity-scroller__high-button {
    display: none;
}

.custom-scroll-view .unity-base-slider__tracker {
    border-left-color: rgb(92, 221, 138);
    border-right-color: rgb(92, 221, 138);
    border-top-color: rgb(92, 221, 138);
    border-bottom-color: rgb(92, 221, 138);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-right-radius: 11px;
    border-bottom-left-radius: 11px;
    background-color: rgba(0, 0, 0, 0);
}

.custom-scroll-view .unity-scroll-view__vertical-scroller {
    width: 39px;
    align-items: center;
}

.custom-scroll-view .unity-scroller__slider {
    width: 28px;
}

.rebind-button {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgb(92, 221, 138);
    border-right-color: rgb(92, 221, 138);
    border-top-color: rgb(92, 221, 138);
    border-bottom-color: rgb(92, 221, 138);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-right-radius: 26px;
    border-bottom-left-radius: 26px;
    margin-bottom: 5px;
    margin-top: 5px;
    font-size: 30px;
}

.rebind-button:hover {
    background-color: rgba(92, 221, 138, 0.271);
    border-left-color: rgb(92, 221, 138);
    border-right-color: rgb(92, 221, 138);
    border-top-color: rgb(92, 221, 138);
    border-bottom-color: rgb(92, 221, 138);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-right-radius: 26px;
    border-bottom-left-radius: 26px;
    margin-bottom: 5px;
    margin-top: 5px;
}

.rebind-button:active {
    background-color: rgba(92, 221, 138, 0.631);
    border-left-color: rgb(92, 221, 138);
    border-right-color: rgb(92, 221, 138);
    border-top-color: rgb(92, 221, 138);
    border-bottom-color: rgb(92, 221, 138);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-right-radius: 26px;
    border-bottom-left-radius: 26px;
    margin-bottom: 5px;
    margin-top: 5px;
}
