<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:GroupBox style="height: 166px; flex-direction: row; background-color: rgb(77, 103, 212); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;">
        <ui:VisualElement name="LobbyPlayerImg" style="flex-grow: 0; background-color: rgb(152, 152, 152); width: 110px; -unity-background-scale-mode: scale-to-fit; aspect-ratio: 1; align-self: center;"/>
        <ui:GroupBox style="flex-grow: 1;">
            <ui:Label text="Label" name="LobbyPlayerNameLb" style="font-size: 45px; text-overflow: ellipsis;"/>
            <ui:Label text="Label" name="LobbyPlayerReadyStatusLb" style="font-size: 45px;"/>
        </ui:GroupBox>
    </ui:GroupBox>
</ui:UXML>
