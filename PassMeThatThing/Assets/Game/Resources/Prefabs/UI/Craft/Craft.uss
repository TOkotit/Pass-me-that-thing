.bordered-rect {
    border-left-color: rgb(89, 185, 123);
    border-right-color: rgb(89, 185, 123);
    border-top-color: rgb(89, 185, 123);
    border-bottom-color: rgb(89, 185, 123);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-right-radius: 32px;
    border-bottom-left-radius: 32px;
}

.thin-bordered-rect {
    border-left-color: rgb(89, 185, 123);
    border-right-color: rgb(89, 185, 123);
    border-top-color: rgb(89, 185, 123);
    border-bottom-color: rgb(89, 185, 123);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.title {
    font-size: 56px;
    -unity-text-align: middle-center;
    color: rgb(92, 221, 138);
}

.physical-button {
    color: rgb(140, 61, 14);
}

.physical-button:active {
    -unity-background-image-tint-color: rgb(115, 115, 115);
    color: rgb(241, 159, 108);
}

.recipe-button {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgb(89, 185, 123);
    border-right-color: rgb(89, 185, 123);
    border-top-color: rgb(89, 185, 123);
    border-bottom-color: rgb(89, 185, 123);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 21px;
    border-top-right-radius: 21px;
    border-bottom-right-radius: 21px;
    border-bottom-left-radius: 21px;
    transition-property: scale;
    transition-duration: 0.2s;
}

.recipe-button__selected {
    scale: 0.8 0.8;
}

.recipe-button:hover {
    background-color: rgba(89, 185, 123, 0.157);
    border-left-color: rgb(89, 185, 123);
    border-right-color: rgb(89, 185, 123);
    border-top-color: rgb(89, 185, 123);
    border-bottom-color: rgb(89, 185, 123);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 21px;
    border-top-right-radius: 21px;
    border-bottom-right-radius: 21px;
    border-bottom-left-radius: 21px;
}

.recipe-button:active {
    background-color: rgba(89, 185, 123, 0.412);
}

.dropgroup {
    position: relative;
    margin: 4px;
    color: rgb(89, 185, 123);
}

.dropgroup__button {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(43, 43, 43, 0);
    border-color: rgb(30, 30, 30);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 10px;
    margin: 0;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(92, 221, 138);
    border-right-color: rgb(92, 221, 138);
    border-top-color: rgb(92, 221, 138);
    border-bottom-color: rgb(92, 221, 138);
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-right-radius: 26px;
    border-bottom-left-radius: 26px;
}

.dropgroup__button:hover {
    background-color: rgba(92, 221, 138, 0.396);
}

.dropgroup__label {
    font-size: 35px;
}

.dropgroup__arrow {
    transition: rotate 0.2s;
    background-image: resource("Sprites/Menu/ArrowIcon");
    width: 50px;
    height: 50px;
}

.dropgroup__arrow--open {
    rotate: 180deg;
}

.dropgroup__content {
    border-color: rgb(26, 26, 26);
    border-width: 1px;
    border-radius: 4px;
    flex-grow: 1;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-color: rgba(26, 26, 26, 0);
    border-right-color: rgba(26, 26, 26, 0);
    border-top-color: rgba(26, 26, 26, 0);
    border-bottom-color: rgba(26, 26, 26, 0);
}

.resource-preview {
    aspect-ratio: 1;
    align-self: center;
}

.resource-preview__not-success {
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
}
