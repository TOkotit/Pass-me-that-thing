.my-custom-list .unity-list-view__item {
    background-color: transparent;
    transition: background-color 0.15s ease;
    transition-property: scale;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    margin-bottom: 15px;
}

.my-custom-list .unity-list-view__item:hover {
    background-color: transparent;
}

.my-custom-list .unity-collection-view__item--selected {
    background-color: transparent;
    scale: 0.9 0.9;
    border-left-color: rgb(92, 221, 138);
    border-right-color: rgb(92, 221, 138);
    border-top-color: rgb(92, 221, 138);
    border-bottom-color: rgb(92, 221, 138);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
}

.my-custom-list .unity-collection-view__item--selected:hover {
    background-color: transparent;
}

.my-custom-list .unity-list-view__item:focus {
    background-color: transparent;
}

.bordered-rect {
    border-left-color: rgb(89, 185, 123);
    border-right-color: rgb(89, 185, 123);
    border-top-color: rgb(89, 185, 123);
    border-bottom-color: rgb(89, 185, 123);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-right-radius: 32px;
    border-bottom-left-radius: 32px;
}

.thin-bordered-rect {
    border-left-color: rgb(89, 185, 123);
    border-right-color: rgb(89, 185, 123);
    border-top-color: rgb(89, 185, 123);
    border-bottom-color: rgb(89, 185, 123);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.title {
    font-size: 56px;
    -unity-text-align: middle-center;
    color: rgb(92, 221, 138);
}

.physical-button {
    color: rgb(140, 61, 14);
}

.physical-button:active {
    -unity-background-image-tint-color: rgb(115, 115, 115);
    color: rgb(241, 159, 108);
}
